{
  "name": "@nublai/pi-worker",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "pi-worker supervisor daemon (Node 26)",
  "engines": {
    "node": ">=26.12.1"
  },
  "main": "dist/src/main.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp src/generated/validators.js dist/src/generated/validators.js",
    "test": "npm run build && node ../../tools/node-test.mjs 'dist/test/**/*.test.js'",
    "test:conformance": "npm run build && node ../../tools/node-test.mjs 'dist/test/conformance/**/*.test.js'",
    "test:crash": "npm run build && node ../../tools/node-test.mjs 'dist/test/crash/**/*.test.js'"
  },
  "devDependencies": {
    "@nublai/pi-worker-client": "0.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2"
  }
}
