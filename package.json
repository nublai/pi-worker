{
  "name": "pi-worker",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "nubl's headless pi execution component: one supervisor per Linux user, typed B2 API over a private Unix socket",
  "engines": {
    "node": ">=26.12.1"
  },
  "workspaces": [
    "packages/worker"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3"
  }
}
