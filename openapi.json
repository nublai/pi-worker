  "info": {
    "title": "THROWAWAY nubl A0 slice 1 B2",
    "version": "0.1.0",
    "description": "Private Unix socket HTTP only. OS owner access, no grants/peer UID API in this slice. Unsupported methods fail explicitly. Not production, not contract freeze."
  },
  "servers": [
    {
      "url": "http://a0-unix-socket"
    }
  ],
