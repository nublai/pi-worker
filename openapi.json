            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "binding_revision": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "command_id",
          "worker_epoch",
          "session_id",
          "binding_revision",
          "message"
        ],
        "additionalProperties": false
      },
      "Execution": {
        "type": "object",
        "properties": {
          "execution_id": {
            "type": "string"
          },
          "command_id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "admitted",
              "started",
              "settled",
              "outcome_unknown"
            ]
          },
          "disposition": {
            "type": "string"
          }
        },
        "required": [
          "execution_id",
          "command_id",
          "state"
        ],
        "additionalProperties": false
      },
      "Fence": {
        "type": "object",
        "properties": {
          "command_id": {
            "type": "string"
          },
          "fence_generation": {
            "type": "integer"
          },
          "uncertain_command_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": [
          "command_id",
          "fence_generation"
        ],
        "additionalProperties": false
      },
      "Worker": {
        "type": "object",
        "properties": {
          "worker_id": {
            "type": "string"
          },
          "worker_epoch": {
            "type": "string"
          },
          "supervisor_epoch": {
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "session_identity_evidence": {
            "enum": [
              "pi_rpc_header_id",
              "pi_session_file",
              "durable_conversation_id"
            ]
          },
          "binding_revision": {
            "type": "integer"
          },
          "leaf_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "cwd": {
            "type": "string"
          },
          "status": {
            "enum": [
              "starting",
              "ready",
              "stopped",
              "cleanup_pending",
              "failed"
            ]
          },
          "foreground": {
            "enum": [
              "idle",
              "running",
              "unknown"
            ]
          },
          "execution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Execution"
              },
              {
                "type": "null"
              }
            ]
          },
          "fence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Fence"
              },
              {
                "type": "null"
              }
            ]
          },
          "history": {
            "$ref": "#/components/schemas/HistoryMarker"
          },
          "cleanup": {
            "type": "string"
          },
          "pending_interactions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "native_id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                }
              },
              "required": [
                "native_id",
                "kind"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "worker_id",
          "worker_epoch",
          "supervisor_epoch",
          "session_id",
          "session_identity_evidence",
          "binding_revision",
          "leaf_id",
          "cwd",
          "status",
          "foreground",
          "execution",
          "fence",
          "history",
          "cleanup",
          "pending_interactions"
        ],
        "additionalProperties": false
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "command_id": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "workers.create",
              "sessions.prompt",
              "workers.stop"
            ]
          },
          "request_hash": {
            "type": "string"
          },
          "state": {
            "enum": [
              "intent",
              "intent_recovered",
              "accepted",
              "delivered",
              "rejected",
              "outcome_unknown"
            ]
          },
          "stage": {
            "enum": [
              "reserved",
              "recovery_pending",
              "dispatch_recorded",
              "forwarded",
              "termination_observed",
              "refused",
              "unknown"
            ]
          },
          "effect": {
            "enum": [
              "no_effect",
              "unknown",
              "observed"
            ]
          },
          "evidence": {
            "enum": ["supervisor_journal_fsynced", "durable_storage"]
          },
          "created_at": {
            "type": "string"
          },
          "worker_id": {
            "type": "string"
          },
          "execution_id": {
            "type": "string"
          },
          "admission": {
            "enum": [
              "accepted",
              "rejected"
            ]
          },
          "disposition": {
            "type": "string"
          },
          "history_lag": {
            "type": "boolean"
          },
          "uncertain_command_id": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "command_id",
          "operation",
          "request_hash",
          "state",
          "stage",
          "effect",
          "evidence",
          "created_at"
        ],
        "additionalProperties": false
      },
      "Hello": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "object",
            "properties": {
              "major": {
                "const": 0
              },
              "minor": {
                "const": 1
              }
            },
            "required": [
              "major",
              "minor"
            ],
            "additionalProperties": false
          },
          "prototype": {
            "const": true
          },
          "supervisor_id": {
            "type": "string"
          },
          "supervisor_epoch": {
            "type": "string"
          },
          "pi_version": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": true
          },
          "resource_profile": {
            "type": "string"
          },
          "cleanup_profile": {
            "type": "string"
          }
        },
        "required": [
          "protocol",
          "prototype",
          "supervisor_id",
          "supervisor_epoch",
          "pi_version",
          "capabilities",
          "limits",
          "resource_profile",
          "cleanup_profile"
        ],
        "additionalProperties": false
      },
      "HistoryCursor": {
        "type": "object",
        "properties": {
          "watermark": {
            "type": "string"
          },
          "after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "watermark",
          "after"
        ],
        "additionalProperties": false
      },
      "HistoryPage": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "watermark": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "next": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HistoryCursor"
              },
              {
                "type": "null"
              }
            ]
          },
          "leafId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
