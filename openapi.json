            "type": "boolean"
          },
          "evidence": {
            "enum": ["pi_session_file", "durable_storage"]
          }
        },
        "required": [
          "entries",
          "watermark",
          "next",
          "leafId",
          "truncated",
          "evidence"
        ],
        "additionalProperties": false
      },
      "Snapshot": {
        "type": "object",
        "properties": {
          "type": {
            "const": "snapshot"
          },
          "worker": {
            "$ref": "#/components/schemas/Worker"
          },
          "cursor": {
            "$ref": "#/components/schemas/Cursor"
          },
          "history": {
            "$ref": "#/components/schemas/HistoryMarker"
          },
          "resync_reason": {
            "enum": [
              "fresh",
              "current",
              "gap",
              "epoch",
              "ahead",
