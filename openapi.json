  "components": {
    "schemas": {
      "Cursor": {
        "description": "Transport epoch in worker_epoch is independent of the worker binding epoch and changes on every supervisor start.",
        "type": "object",
        "properties": {
          "worker_epoch": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "worker_epoch",
          "seq"
        ],
        "additionalProperties": false
      },
      "HistoryMarker": {
        "type": "object",
        "properties": {
          "last_entry_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "lag": {
            "type": "boolean"
          },
          "evidence": {
            "enum": ["pi_session_file", "durable_storage"]
          }
        },
        "required": [
          "last_entry_id",
          "lag",
          "evidence"
        ],
        "additionalProperties": false
      },
      "Binding": {
